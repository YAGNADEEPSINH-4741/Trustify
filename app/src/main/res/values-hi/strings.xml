    <!-- Onboarding -->
    <string name="onboarding_false_spam_title">फ़ाल्स स्पैम की समस्या</string>
    <string name="onboarding_false_spam_desc">डिलीवरी पार्टनर्स, ड्राइवर्स और सर्विस एजेंट्स रोज़ाना कई कॉल्स करते हैं। सामान्य ऐप्स अक्सर उन्हें स्पैम बताकर ब्लॉक कर देते हैं, जिससे पार्सल और राइड्स छूट जाती हैं।\n\nTrustify आपके व्यक्तिगत डेटा को किसी बाहरी सर्वर पर भेजे बिना, ऑन-डिवाइस प्रामाणिक जानकारी के आधार पर सही पहचान करता है।</string>
