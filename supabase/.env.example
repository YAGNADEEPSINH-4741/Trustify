# Supabase Configuration for SafeCall AI
# Copy this to .env or input values into the in-app Settings screen.

# Your Supabase Project URL (found in Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anonymous API Key (safe to use in client Android apps)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# NOTE: Never put SUPABASE_SERVICE_ROLE_KEY into the Android application or client repository!
